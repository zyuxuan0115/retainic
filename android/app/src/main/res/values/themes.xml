<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme. Compose supplies its own Material 3 color scheme; this
         theme only styles the window while the activity starts up. -->
    <style name="Theme.Retainic" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
